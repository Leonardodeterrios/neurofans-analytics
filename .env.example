# Скопируй в .env и заполни. .env в git НЕ попадёт (см. .gitignore).

# Токен бота от @BotFather (тот же бот, что крутится в PuzzleBot).
# Нужен ТОЛЬКО чтобы слать тебе уведомления/сводки (sendMessage) — polling мы не запускаем,
# поэтому конфликта с PuzzleBot нет.
BOT_TOKEN=put-your-bot-token-here
BOT_USERNAME=AccessGrantedGuide_bot

# Твой chat_id для уведомлений, сводок и алертов. Узнать: напиши @userinfobot в Telegram.
ADMIN_CHAT_ID=

# Секрет для приёма переходов на /track (чтобы чужие не слали фейковые переходы).
# Если задан — PuzzleBot должен слать .../track?...&key=ЭТОТ_СЕКРЕТ. Пусто = без защиты.
INGEST_TOKEN=

# Google Apps Script web-app URL (необязательно, дублировать переходы в таблицу).
SHEET_WEBHOOK_URL=

# Ежедневная авто-сводка: время HH:MM и таймзона. Пусто = выкл.
DAILY_SUMMARY_TIME=
SUMMARY_TZ=Asia/Bangkok

# Алерты «тишина по источнику»
SILENCE_HOURS=24          # нет переходов столько часов -> алерт
SILENCE_CHECK_MIN=60      # как часто проверять (минут)
SILENCE_MIN_CLICKS=3      # алерт только для источников, где исторически было >= столько переходов

# Веб-дашборд
DASHBOARD_TOKEN=          # если задан, нужен ?token=... для доступа. Пусто = без пароля.
DASHBOARD_PORT=8080

# Путь к локальной базе переходов
DB_PATH=data/starts.db
