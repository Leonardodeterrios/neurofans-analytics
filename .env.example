# Скопируй в .env и заполни. .env в git НЕ попадёт (см. .gitignore).

# Бот, куда перекидываем после клика по ссылке (тот, что в PuzzleBot). Без @.
BOT_USERNAME=AccessGrantedGuide_bot

# Адрес для ссылок партнёров (make_links.py): сейчас IP, после подключения домена — https://ваш-домен. Без / на конце.
DOMAIN=go.ai-creators.ru         # домен трекера: caddy сам получает HTTPS-сертификат
BASE_URL=https://go.ai-creators.ru

# Токен бота от @BotFather — ТОЛЬКО для уведомлений/сводок (sendMessage).
# polling не запускаем, поэтому конфликта с PuzzleBot нет. Можно оставить пустым,
# тогда уведомления просто не шлются.
BOT_TOKEN=

# chat_id(ы) для уведомлений/итогов. Можно несколько через запятую. Узнать: @userinfobot
ADMIN_CHAT_ID=

# Слать ли уведомление на каждый переход (1 = да, 0 = нет, только сводки/алерты).
NOTIFY_CLICKS=1

# Google Apps Script web-app URL (необязательно, дублировать переходы в таблицу).
SHEET_WEBHOOK_URL=

# Команды (две копилки). Партнёр попадает в команду по префиксу метки.
TEAM_A_NAME=Команда Лёни
TEAM_A_PREFIX=leo
TEAM_B_NAME=Команда Кати
TEAM_B_PREFIX=kate
PER_TEAM=50               # сколько ссылок на команду (для make_links.py)

# Ежедневные итоги + победитель дня в Telegram: время HH:MM и таймзона. Пусто = выкл.
DAILY_SUMMARY_TIME=21:00
SUMMARY_TZ=Asia/Bangkok

# Алерты «тишина по источнику»
SILENCE_HOURS=24          # нет переходов столько часов -> алерт
SILENCE_CHECK_MIN=60      # как часто проверять (минут)
SILENCE_MIN_CLICKS=3      # алерт только для аккаунтов, где исторически было >= столько переходов

# Веб-дашборд
DASHBOARD_TOKEN=          # если задан, нужен ?token=... для доступа. Пусто = без пароля.
PUBLIC_TOKEN=             # пароль «только арена» для партнёров: /arena?token=... (без доступа к CSV/IP)
DASHBOARD_PORT=8080

# Путь к локальной базе переходов
DB_PATH=data/clicks.db

# Сверка «клик → старт в боте». PuzzleBot на /start шлёт:
#   GET https://ДОМЕН/bot/start?p=<start-параметр>&uid=<telegram id>&key=<INGEST_TOKEN>
# Пустой ключ = приём стартов выключен.
INGEST_TOKEN=
START_POWER=3             # сколько силы даёт человек, дошедший до бота («апперкот»)
NOTIFY_STARTS=1
NOTIFY_ACTIONS=0             # 1 — уведомлять о каждом действии в боте (кнопки PuzzleBot)           # уведомлять о каждом апперкоте

# Честный подсчёт
MAX_PARTNERS_PER_VISITOR=3   # одному человеку засчитываются удары максимум трём партнёрам за раунд
MAX_HITS_PER_IP=100          # и не больше 100 ударов с одного IP за раунд
TRUST_CF=0                   # Cloudflare не используем (в РФ режется); 1 — только если сайт за Cloudflare

# --- Личные страницы партнёров, гео, карточки ---
PARTNER_SECRET=              # секрет для личных ссылок /p/<метка>?k=... (задай один раз: openssl rand -hex 16)
GEO=1                        # 1 — показывать города кликов на арене (база DB-IP Lite качается сама в data/)
PER_TEAM=50                  # сколько партнёров в команде (для CSV личных ссылок)

# --- Кабинет учеников: оплата курса через Tribute ---
# id цифровых товаров курса в Tribute: base — Базовый, adv — Продвинутый, up — доплата с Базового до Продвинутого.
# В каждом товаре Tribute выдать ссылку https://t.me/NeuroFansLab_bot?start=buy
TRIBUTE_COURSE=              # например, 111:base,222:adv,333:up
