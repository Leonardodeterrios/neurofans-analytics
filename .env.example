# Скопируй в .env и заполни. .env в git НЕ попадёт (см. .gitignore).
BOT_TOKEN=put-your-bot-token-here
BOT_USERNAME=NeuroFansBot
# URL веб-приложения Google Apps Script (необязательно, для записи в таблицу)
SHEET_WEBHOOK_URL=
# Твой chat_id для уведомлений о переходах (узнать: команда /myid в боте). Необязательно.
ADMIN_CHAT_ID=
# Путь к локальной базе переходов (по умолчанию data/starts.db)
DB_PATH=data/starts.db
