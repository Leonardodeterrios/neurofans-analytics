# Скопируй в .env и заполни. .env в git НЕ попадёт (см. .gitignore).
BOT_TOKEN=put-your-bot-token-here
BOT_USERNAME=NeuroFansBot

# Google Apps Script web-app URL (необязательно, для записи в таблицу)
SHEET_WEBHOOK_URL=

# Твой chat_id для уведомлений и /stats (узнать: команда /myid в боте). Необязательно.
ADMIN_CHAT_ID=

# Ежедневная авто-сводка тебе в ЛС: время HH:MM и таймзона. Пусто = выключено.
DAILY_SUMMARY_TIME=
SUMMARY_TZ=Asia/Bangkok

# Путь к локальной базе переходов
DB_PATH=data/starts.db
