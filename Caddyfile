	@threads path /t /t/
	@video path /v /v/
	@robots path /robots.txt /favicon.ico
	handle @robots {
		respond 404
	}
	handle @threads {
		rewrite * /t/{nf_label}
		reverse_proxy app:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle @video {
		rewrite * /v/{nf_label}
		reverse_proxy app:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	# всё остальное (корень и любой путь) — канал домена по умолчанию; дашборд/арена тут не открываются
	handle {
		rewrite * /{nf_ch}/{nf_label}
		reverse_proxy app:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
}

