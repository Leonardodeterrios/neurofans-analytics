# HTTPS для трекера: Caddy сам получает и продлевает бесплатный сертификат Let's Encrypt.
# Домен берётся из DOMAIN в .env (например go.ai-creators.ru). Cloudflare не используем:
# с июня 2025 российские провайдеры режут сайты за Cloudflare.

{$DOMAIN} {
	reverse_proxy app:8080 {
		header_up X-Real-IP {remote_host}
	}
}

# http://домен → https://домен (тот же путь)
http://{$DOMAIN} {
	redir https://{host}{uri} 308
}

# Кабинет учеников NeuroFans Lab: lab.<домен> — кабинет, to.<домен>/<метка> — ссылки учеников,
# сам <домен> и www → кабинет. Отдельный сервис lab, трекер партнёров не затрагивает.
lab.{$LAB_ROOT:neurofans.ru}, to.{$LAB_ROOT:neurofans.ru}, {$LAB_ROOT:neurofans.ru}, www.{$LAB_ROOT:neurofans.ru} {
	reverse_proxy lab:8090 {
		header_up X-Real-IP {remote_host}
	}
}

http://lab.{$LAB_ROOT:neurofans.ru}, http://to.{$LAB_ROOT:neurofans.ru}, http://{$LAB_ROOT:neurofans.ru}, http://www.{$LAB_ROOT:neurofans.ru} {
	redir https://{host}{uri} 308
}

# Короткие домены партнёров (.shop, Spaceship, DNS у регистратора: A-записи @, go, my, hi → IP сервера).
# Каждый хост (домен или поддомен) = одна метка. Клик идёт сразу в трекер (тот же подсчёт, что /t/ и /v/),
# без промежуточного редиректа на go.ai-creators.ru.
#   хост/    → канал по умолчанию: «л…» — Threads (/t/), «к…» — видео (/v/)
#   хост/t   → Threads,  хост/v → видео (Shorts/Reels/TikTok)
