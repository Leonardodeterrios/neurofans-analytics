# HTTPS для трекера: Caddy сам получает и продлевает бесплатный сертификат Let's Encrypt.
# Домен берётся из DOMAIN в .env (например go.ai-creators.ru). Cloudflare не используем:
# с июня 2025 российские провайдеры режут сайты за Cloudflare.

{$DOMAIN} {
	reverse_proxy app:8080 {
		header_up X-Real-IP {remote_host}
	}
}

# http://домен → https://домен (тот же путь)
http://{$DOMAIN} {
	redir https://{host}{uri} 308
}

# Кабинет учеников NeuroFans Lab: lab.<домен> — кабинет, to.<домен>/<метка> — ссылки учеников.
# Отдельный сервис lab, трекер партнёров не затрагивает.
lab.{$LAB_ROOT:neurofans.ru}, to.{$LAB_ROOT:neurofans.ru} {
	reverse_proxy lab:8090 {
		header_up X-Real-IP {remote_host}
	}
}

http://lab.{$LAB_ROOT:neurofans.ru}, http://to.{$LAB_ROOT:neurofans.ru}, http://{$LAB_ROOT:neurofans.ru}, http://www.{$LAB_ROOT:neurofans.ru}, http://new.{$LAB_ROOT:neurofans.ru} {
	redir https://{host}{uri} 308
}

# Сайт курса (с 28.11.2026 на корне домена; раньше — new.<домен>). Статика из папки site/.
# Старые адреса кабинета на корне (инвайты, админка, API) уводим на lab., чтобы ничего не сломалось.
{$LAB_ROOT:neurofans.ru} {
	@lab {
		path /admin* /api/* /r/* /manifest.webmanifest /sw.js /icon-*
	}
	redir @lab https://lab.{$LAB_ROOT:neurofans.ru}{uri} 302
	@invite query invite=*
	redir @invite https://lab.{$LAB_ROOT:neurofans.ru}{uri} 302
	handle_path /fonts/* {
		root * /srv/fonts
		file_server
	}
	handle {
		root * /srv/site
		try_files {path} {path}/ {path}.html
		file_server
	}
}

# www. и старый адрес new. → основной домен (тот же путь)
www.{$LAB_ROOT:neurofans.ru}, new.{$LAB_ROOT:neurofans.ru} {
	redir https://{$LAB_ROOT:neurofans.ru}{uri} 301
}

