# HTTPS для ретранслятора: сертификат Let's Encrypt на RELAY_DOMAIN (A-запись → IP этого сервера).
{$RELAY_DOMAIN} {
	# Telegram Bot API для серверов в РФ (оттуда api.telegram.org недоступен): /tg/bot<токен>/<метод>
	@tg path_regexp ^/tg/bot[0-9]+:[A-Za-z0-9_-]+/[A-Za-z]+$
	handle @tg {
		uri strip_prefix /tg
		reverse_proxy https://api.telegram.org {
			header_up Host api.telegram.org
		}
	}
	# файлы из Telegram (картинки из отзывов учеников): /tg/file/bot<токен>/<путь>
	@tgf path_regexp ^/tg/file/bot[0-9]+:[A-Za-z0-9_-]+/[A-Za-z0-9_./-]+$
	handle @tgf {
		uri strip_prefix /tg
		reverse_proxy https://api.telegram.org {
			header_up Host api.telegram.org
		}
	}
	handle {
		reverse_proxy relay:8080
	}
}

# Галерея примеров генераций 18+ (gallery/setup.sh). Файлы — /opt/nf-gallery, страница — из репозитория.
{$GALLERY_DOMAIN:gallery.localhost} {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	header Referrer-Policy no-referrer
	handle_path /fonts/* {
		root * /srv/fonts
		file_server
	}
	@data path /media.json /media/*
	handle @data {
		header Cache-Control "public, max-age=300"
		root * /srv/gallery-data
		file_server
	}
	handle {
		root * /srv/gallery
		file_server
	}
}
